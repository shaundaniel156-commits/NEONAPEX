{
 "dialogue": [
  {
   "id": "s3_00_grace",
   "speaker": "Grace",
   "text": "How much do you need?",
   "file": "audio/dialogue/generated/s3_00_grace.wav",
   "t": 14.6,
   "duration": 2.346
  },
  {
   "id": "s3_01_daniel",
   "speaker": "Daniel",
   "text": "Mum, forget it. I'll find another way.",
   "file": "audio/dialogue/generated/s3_01_daniel.wav",
   "t": 17.6,
   "duration": 3.825
  },
  {
   "id": "s3_02_grace",
   "speaker": "Grace",
   "text": "Take this.",
   "file": "audio/dialogue/generated/s3_02_grace.wav",
   "t": 26.2,
   "duration": 1.357
  },
  {
   "id": "s3_03_daniel",
   "speaker": "Daniel",
   "text": "Mum, no. You need that money.",
   "file": "audio/dialogue/generated/s3_03_daniel.wav",
   "t": 28.2,
   "duration": 3.198
  },
  {
   "id": "s3_04_grace",
   "speaker": "Grace",
   "text": "Daniel, opportunities don't come every day. Go and do your best.",
   "file": "audio/dialogue/generated/s3_04_grace.wav",
   "t": 32.4,
   "duration": 6.033
  },
  {
   "id": "s3_05_daniel",
   "speaker": "Daniel",
   "text": "I won't disappoint you.",
   "file": "audio/dialogue/generated/s3_05_daniel.wav",
